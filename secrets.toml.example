# 배포·로컬용 Streamlit Secrets 예시. .streamlit/secrets.toml로 복사해 값을 채운다.
# secrets.toml은 GitHub에 올리지 않는다(.gitignore). 채우는 방법은 SETUP-google-sheets.md 5단계 참고.

OPENAI_API_KEY = ""
OPENAI_MODEL = ""
# OPENAI_BASE_URL = ""
# OPENAI_MAX_OUTPUT_TOKENS = ""
# OPENAI_TEMPERATURE = ""
# OPENAI_TIMEOUT_SEC = ""

SHEET_URL = ""
CONTEST_ID = ""
# PIN_SALT = ""
# ADMIN_PASSWORD = ""

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
